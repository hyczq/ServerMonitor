<Window x:Class="ServerMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="服务器监控台"
        Icon="app.ico"
        Height="840" Width="1400"
        MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource PagePlane}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ================= 标题栏 ================= -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceCard}"
            BorderBrush="{DynamicResource StrokeHairline}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 应用标识 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0"
                    VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="7"
                  Background="{DynamicResource Accent}">
            <Path Data="{StaticResource IconServer}" Stroke="White" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Fill="Transparent" Stretch="Uniform" Width="15" Height="15" />
          </Border>
          <TextBlock Text="服务器监控台" Margin="10,0,0,0" VerticalAlignment="Center"
                     FontSize="13.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
        </StackPanel>

        <!-- 标题栏按钮组：需要显式声明可命中，否则会被 WindowChrome 当作拖拽区吃掉 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="ThemeButton" Style="{StaticResource IconButton}"
                  Click="OnToggleTheme" ToolTip="切换深色 / 浅色主题">
            <Viewbox Width="17" Height="17">
              <Path x:Name="ThemeIcon" Style="{StaticResource IconPath}"
                    Data="{DynamicResource IconSun}"
                    Stroke="{Binding Foreground,
                             RelativeSource={RelativeSource AncestorType=Button}}" />
            </Viewbox>
          </Button>

          <Border Width="1" Margin="6,10" Background="{DynamicResource StrokeHairline}" />

          <Button Style="{StaticResource WindowChromeButton}" Click="OnMinimize" ToolTip="最小化">
            <Viewbox Width="16" Height="16">
              <Path Style="{StaticResource IconPath}"
                    Data="{StaticResource IconMinimize}"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Viewbox>
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowChromeButton}"
                  Click="OnMaximizeRestore" ToolTip="最大化">
            <Viewbox Width="14" Height="14">
              <Path x:Name="MaximizeIcon" Style="{StaticResource IconPath}"
                    Data="{StaticResource IconMaximize}"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Viewbox>
          </Button>
          <Button Style="{StaticResource WindowCloseButton}" Click="OnClose" ToolTip="关闭">
            <Viewbox Width="15" Height="15">
              <Path Style="{StaticResource IconPath}"
                    Data="{StaticResource IconClose}"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= 主体 ================= -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧导航 -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceCard}"
              BorderBrush="{DynamicResource StrokeHairline}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ListBox x:Name="NavList" Grid.Row="0" Margin="0,14,0,0"
                   Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource NavItem}"
                   SelectedIndex="0"
                   SelectionChanged="OnNavSelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBoxItem>
              <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                <Viewbox Width="18" Height="18">
                  <Path Style="{StaticResource IconPath}"
                        Data="{StaticResource IconDashboard}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                </Viewbox>
                <TextBlock Text="总览" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                <Viewbox Width="18" Height="18">
                  <Path Style="{StaticResource IconPath}"
                        Data="{StaticResource IconServer}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                </Viewbox>
                <TextBlock Text="服务器" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                <Viewbox Width="18" Height="18">
                  <Path Style="{StaticResource IconPath}"
                        Data="{StaticResource IconChart}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                </Viewbox>
                <TextBlock Text="历史统计" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                <Viewbox Width="18" Height="18">
                  <Path Style="{StaticResource IconPath}"
                        Data="{StaticResource IconLog}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                </Viewbox>
                <TextBlock Text="诊断日志" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                <Viewbox Width="18" Height="18">
                  <Path Style="{StaticResource IconPath}"
                        Data="{StaticResource IconSettings}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                </Viewbox>
                <TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>

          <!-- 采集状态脚注 -->
          <StackPanel Grid.Row="2" Margin="16,0,16,16">
            <Border Style="{StaticResource Hairline}" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal">
              <Ellipse>
                <Ellipse.Style>
                  <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                    <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCollecting}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource Accent}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Margin="8,0,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                    <Setter Property="Text" Value="等待下一轮" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCollecting}" Value="True">
                        <Setter Property="Text" Value="正在采集" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <TextBlock Text="{Binding LastCycleText}" Margin="0,6,0,0"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RefreshIntervalText}" Margin="0,3,0,0"
                       Style="{StaticResource CaptionText}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 页面容器 -->
      <ContentControl x:Name="ContentHost" Grid.Column="1" />
    </Grid>
  </Grid>
</Window>
