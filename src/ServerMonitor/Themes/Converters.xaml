<!-- 全局值转换器实例，供各视图共用 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ServerMonitor.Converters">

  <conv:HealthToBrushConverter        x:Key="HealthBrush" />
  <conv:HealthToTextConverter         x:Key="HealthText" />
  <conv:HealthToIconConverter         x:Key="HealthIcon" />
  <conv:BytesConverter                x:Key="BytesText" />
  <conv:PercentConverter              x:Key="PercentText" />
  <conv:InverseBooleanConverter       x:Key="InverseBool" />
  <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
  <conv:StringToVisibilityConverter   x:Key="StringToVis" />
  <conv:EmptyToVisibilityConverter    x:Key="EmptyToVis" />
  <conv:ResourceKeyToBrushConverter   x:Key="KeyToBrush" />
  <conv:EnabledLabelConverter         x:Key="EnabledLabel" />
  <conv:StarWidthConverter            x:Key="StarWidth" />
  <conv:LogLevelToBrushConverter      x:Key="LogLevelBrush" />

  <BooleanToVisibilityConverter x:Key="BoolToVis" />

</ResourceDictionary>
