<!--
  图标全部用矢量几何绘制，不依赖任何图标字体。
  原因：Windows Server 2012 R2 上没有 Segoe MDL2 Assets（Win10 才引入），
  用图标字体在目标机上会显示成方框。
  统一 24x24 视框，描边式渲染（Stroke），线宽 1.7。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 总览：四宫格 -->
  <GeometryGroup x:Key="IconDashboard">
    <RectangleGeometry Rect="3.5,3.5,7.2,7.2" RadiusX="1.8" RadiusY="1.8" />
    <RectangleGeometry Rect="13.3,3.5,7.2,7.2" RadiusX="1.8" RadiusY="1.8" />
    <RectangleGeometry Rect="3.5,13.3,7.2,7.2" RadiusX="1.8" RadiusY="1.8" />
    <RectangleGeometry Rect="13.3,13.3,7.2,7.2" RadiusX="1.8" RadiusY="1.8" />
  </GeometryGroup>

  <!-- 服务器：两层机架 + 指示灯 -->
  <GeometryGroup x:Key="IconServer">
    <RectangleGeometry Rect="3.5,4.5,17,6" RadiusX="1.8" RadiusY="1.8" />
    <RectangleGeometry Rect="3.5,13.5,17,6" RadiusX="1.8" RadiusY="1.8" />
    <EllipseGeometry Center="7.2,7.5" RadiusX="1.1" RadiusY="1.1" />
    <EllipseGeometry Center="7.2,16.5" RadiusX="1.1" RadiusY="1.1" />
    <LineGeometry StartPoint="11.5,7.5" EndPoint="16.5,7.5" />
    <LineGeometry StartPoint="11.5,16.5" EndPoint="16.5,16.5" />
  </GeometryGroup>

  <!-- 历史统计：柱状图 -->
  <GeometryGroup x:Key="IconChart">
    <LineGeometry StartPoint="3.5,20.5" EndPoint="20.5,20.5" />
    <RectangleGeometry Rect="5.4,12.4,3.2,8.1" RadiusX="1.2" RadiusY="1.2" />
    <RectangleGeometry Rect="10.4,6.4,3.2,14.1" RadiusX="1.2" RadiusY="1.2" />
    <RectangleGeometry Rect="15.4,9.4,3.2,11.1" RadiusX="1.2" RadiusY="1.2" />
  </GeometryGroup>

  <!-- 日志：文档 + 文本行 -->
  <GeometryGroup x:Key="IconLog">
    <PathGeometry Figures="M6.5,3.5 H14 L18.5,7.5 V20.5 H6.5 Z" />
    <PathGeometry Figures="M14,3.5 V7.5 H18.5" />
    <LineGeometry StartPoint="9.5,11.5" EndPoint="15.5,11.5" />
    <LineGeometry StartPoint="9.5,15" EndPoint="15.5,15" />
    <LineGeometry StartPoint="9.5,18" EndPoint="13.5,18" />
  </GeometryGroup>

  <!-- 设置：滑杆 -->
  <GeometryGroup x:Key="IconSettings">
    <LineGeometry StartPoint="3.5,8" EndPoint="20.5,8" />
    <LineGeometry StartPoint="3.5,16" EndPoint="20.5,16" />
    <EllipseGeometry Center="9,8" RadiusX="2.6" RadiusY="2.6" />
    <EllipseGeometry Center="15,16" RadiusX="2.6" RadiusY="2.6" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconPlus">
    <LineGeometry StartPoint="12,5" EndPoint="12,19" />
    <LineGeometry StartPoint="5,12" EndPoint="19,12" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconRefresh">
    <PathGeometry Figures="M19.5,12 A7.5,7.5 0 1 1 12,4.5" />
    <PathGeometry Figures="M8.8,2.4 L13.2,4.5 L8.8,6.6 Z" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconClose">
    <LineGeometry StartPoint="6.5,6.5" EndPoint="17.5,17.5" />
    <LineGeometry StartPoint="17.5,6.5" EndPoint="6.5,17.5" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconMinimize">
    <LineGeometry StartPoint="6.5,12" EndPoint="17.5,12" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconMaximize">
    <RectangleGeometry Rect="6.5,6.5,11,11" RadiusX="1.4" RadiusY="1.4" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconRestore">
    <PathGeometry Figures="M8.5,6.5 H17.5 V15.5" />
    <PathGeometry Figures="M6.5,9.5 V17.5 H14.5 V9.5 Z" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconSun">
    <EllipseGeometry Center="12,12" RadiusX="4" RadiusY="4" />
    <LineGeometry StartPoint="12,2.6" EndPoint="12,5" />
    <LineGeometry StartPoint="12,19" EndPoint="12,21.4" />
    <LineGeometry StartPoint="2.6,12" EndPoint="5,12" />
    <LineGeometry StartPoint="19,12" EndPoint="21.4,12" />
    <LineGeometry StartPoint="5.4,5.4" EndPoint="7.1,7.1" />
    <LineGeometry StartPoint="16.9,16.9" EndPoint="18.6,18.6" />
    <LineGeometry StartPoint="18.6,5.4" EndPoint="16.9,7.1" />
    <LineGeometry StartPoint="5.4,18.6" EndPoint="7.1,16.9" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconMoon">
    <PathGeometry Figures="M20.2,14.8 A8.8,8.8 0 1 1 9.2,3.8 A7,7 0 0 0 20.2,14.8 Z" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconEdit">
    <PathGeometry Figures="M4.5,19.5 V16 L15.5,5 L19,8.5 L8,19.5 Z" />
    <LineGeometry StartPoint="13.4,7.1" EndPoint="16.9,10.6" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconTrash">
    <LineGeometry StartPoint="4,6.5" EndPoint="20,6.5" />
    <PathGeometry Figures="M9,6.5 V4.2 H15 V6.5" />
    <PathGeometry Figures="M6.6,6.5 L7.6,20 H16.4 L17.4,6.5" />
    <LineGeometry StartPoint="10.2,10" EndPoint="10.2,16.8" />
    <LineGeometry StartPoint="13.8,10" EndPoint="13.8,16.8" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconCheck">
    <PathGeometry Figures="M5,12.5 L10,17.5 L19,7" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconWarning">
    <PathGeometry Figures="M12,3.6 L21.4,19.8 H2.6 Z" />
    <LineGeometry StartPoint="12,9.4" EndPoint="12,14.4" />
    <LineGeometry StartPoint="12,16.9" EndPoint="12,17.1" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconInfo">
    <EllipseGeometry Center="12,12" RadiusX="8.4" RadiusY="8.4" />
    <LineGeometry StartPoint="12,11" EndPoint="12,16.6" />
    <LineGeometry StartPoint="12,7.7" EndPoint="12,7.9" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconExport">
    <LineGeometry StartPoint="12,3.5" EndPoint="12,15" />
    <PathGeometry Figures="M7.2,10.4 L12,15.2 L16.8,10.4" />
    <LineGeometry StartPoint="4,19.5" EndPoint="20,19.5" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconPlay">
    <PathGeometry Figures="M8,5 L19,12 L8,19 Z" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconPause">
    <RectangleGeometry Rect="8.4,5,2.6,14" RadiusX="1" RadiusY="1" />
    <RectangleGeometry Rect="13,5,2.6,14" RadiusX="1" RadiusY="1" />
  </GeometryGroup>

  <!-- 眼睛：显示明文口令 -->
  <GeometryGroup x:Key="IconEye">
    <PathGeometry Figures="M2.5,12 C5.5,7 8.8,5 12,5 C15.2,5 18.5,7 21.5,12 C18.5,17 15.2,19 12,19 C8.8,19 5.5,17 2.5,12 Z" />
    <EllipseGeometry Center="12,12" RadiusX="3.2" RadiusY="3.2" />
  </GeometryGroup>

  <!-- 眼睛加斜杠：隐藏明文口令 -->
  <GeometryGroup x:Key="IconEyeOff">
    <PathGeometry Figures="M2.5,12 C5.5,7 8.8,5 12,5 C15.2,5 18.5,7 21.5,12 C18.5,17 15.2,19 12,19 C8.8,19 5.5,17 2.5,12 Z" />
    <EllipseGeometry Center="12,12" RadiusX="3.2" RadiusY="3.2" />
    <LineGeometry StartPoint="4.5,19.5" EndPoint="19.5,4.5" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconSearch">
    <EllipseGeometry Center="10.5,10.5" RadiusX="6.2" RadiusY="6.2" />
    <LineGeometry StartPoint="15.2,15.2" EndPoint="20,20" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconLink">
    <PathGeometry Figures="M10.2,13.8 A4.2,4.2 0 0 1 10.2,7.9 L13.3,4.8 A4.2,4.2 0 0 1 19.2,10.7 L17.4,12.5" />
    <PathGeometry Figures="M13.8,10.2 A4.2,4.2 0 0 1 13.8,16.1 L10.7,19.2 A4.2,4.2 0 0 1 4.8,13.3 L6.6,11.5" />
  </GeometryGroup>

  <GeometryGroup x:Key="IconDisk">
    <EllipseGeometry Center="12,12" RadiusX="8.4" RadiusY="8.4" />
    <EllipseGeometry Center="12,12" RadiusX="2.6" RadiusY="2.6" />
    <LineGeometry StartPoint="14.6,9.4" EndPoint="18,6" />
  </GeometryGroup>

  <!--
    图标渲染样式。
    宽度/高度固定为 24（几何图形的设计尺寸），Stretch=None 表示按原始坐标绘制。

    ⚠️ 不要直接改小 Width/Height：那会把图形裁掉，而不是缩小。
       需要更小的图标时，用 <Viewbox Width="16" Height="16"> 包住这个 Path，
       Viewbox 会等比缩放。这样做还有个好处——所有图标缩放比例一致，
       描边线宽也就一致；若改用 Stretch="Uniform"，每个图标会按各自
       图形边界缩放，线宽会粗细不一。
  -->
  <Style x:Key="IconPath" TargetType="Path">
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

</ResourceDictionary>
