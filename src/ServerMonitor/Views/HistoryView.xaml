<UserControl x:Class="ServerMonitor.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServerMonitor.Controls"
             FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
             TextOptions.TextFormattingMode="Display">

  <UserControl.Resources>

    <Style x:Key="HistoryRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                    Padding="12,8" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 图例项：色块 + 名称，名称才是识别依据 -->
    <DataTemplate x:Key="LegendItem">
      <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
        <Border Width="10" Height="10" CornerRadius="3" VerticalAlignment="Center"
                Background="{Binding SeriesKey, Converter={StaticResource KeyToBrush}}" />
        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource CaptionText}" />
      </StackPanel>
    </DataTemplate>

  </UserControl.Resources>

  <Grid Margin="22,18,22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题与工具栏 -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel>
        <TextBlock Text="历史统计" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="{Binding SummaryText}" Margin="0,5,0,0"
                   Style="{StaticResource BodyText}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="统计日期" VerticalAlignment="Center" Margin="0,0,9,0"
                   Style="{StaticResource CaptionText}" />
        <ComboBox Width="150" Style="{StaticResource AppComboBox}"
                  ItemsSource="{Binding AvailableDates}"
                  SelectedItem="{Binding SelectedDate, Mode=TwoWay}" />
        <Button Content="刷新" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                Command="{Binding RefreshCommand}" />
        <Button Content="导出当日 CSV" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                Command="{Binding ExportCsvCommand}" />
      </StackPanel>
    </Grid>

    <!-- 表头 -->
    <Border Grid.Row="1" Style="{StaticResource SunkenPanel}" Padding="13,9" Margin="0,0,0,4"
            CornerRadius="8,8,0,0" BorderThickness="1,1,1,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.7*" MinWidth="140" />
          <ColumnDefinition Width="86" />
          <ColumnDefinition Width="86" />
          <ColumnDefinition Width="86" />
          <ColumnDefinition Width="94" />
          <ColumnDefinition Width="94" />
          <ColumnDefinition Width="94" />
          <ColumnDefinition Width="104" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="服务器" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="1" Text="在线率" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="2" Text="CPU 均值" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="3" Text="CPU 峰值" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="4" Text="内存均值" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="5" Text="内存峰值" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="6" Text="磁盘均值" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="7" Text="磁盘峰值" Style="{StaticResource TableHeaderText}" />
      </Grid>
    </Border>

    <!-- 数据行 -->
    <Border Grid.Row="2" Style="{StaticResource Card}" CornerRadius="0,0,10,10"
            BorderThickness="1,0,1,1" Height="248">
      <Grid>
        <ListBox Background="Transparent" BorderThickness="0" Padding="4"
                 ItemContainerStyle="{StaticResource HistoryRow}"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.7*" MinWidth="140" />
                  <ColumnDefinition Width="86" />
                  <ColumnDefinition Width="86" />
                  <ColumnDefinition Width="86" />
                  <ColumnDefinition Width="94" />
                  <ColumnDefinition Width="94" />
                  <ColumnDefinition Width="94" />
                  <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <TextBlock Text="{Binding ServerName}" FontSize="12.5" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock Text="{Binding ServerHost}" Style="{StaticResource CaptionText}"
                             Margin="0,1,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding OnlineRateText}"
                           Style="{StaticResource NumericText}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" Text="{Binding CpuAvgText}"
                           Style="{StaticResource NumericText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding CpuMaxText}"
                           Style="{StaticResource NumericText}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="4" Text="{Binding MemAvgText}"
                           Style="{StaticResource NumericText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding MemMaxText}"
                           Style="{StaticResource NumericText}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="6" Text="{Binding DiskAvgText}"
                           Style="{StaticResource NumericText}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                           Fill="{Binding PeakLevel, Converter={StaticResource HealthBrush}}" />
                  <TextBlock Text="{Binding DiskMaxText}" Style="{StaticResource NumericText}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="当日没有采样记录" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Style="{StaticResource BodyText}"
                   Visibility="{Binding Rows.Count, Converter={StaticResource EmptyToVis}}" />
      </Grid>
    </Border>

    <!-- 图表标题与图例 -->
    <Grid Grid.Row="3" Margin="2,18,2,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="{Binding ChartTitle}" VerticalAlignment="Center"
                 Style="{StaticResource SectionText}" />

      <!-- 两条以上序列必须有图例，颜色不能单独承担识别 -->
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Legend}"
                    ItemTemplate="{StaticResource LegendItem}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Grid>

    <!-- 走势图 -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10,8,10,4" MinHeight="200">
      <controls:TrendChart Series="{Binding TrendSeries}" Labels="{Binding TrendLabels}" />
    </Border>
  </Grid>
</UserControl>
