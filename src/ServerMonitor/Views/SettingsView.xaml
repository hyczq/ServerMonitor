<UserControl x:Class="ServerMonitor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
             TextOptions.TextFormattingMode="Display">

  <UserControl.Resources>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      设置卡片：撑满内容区可用宽度，与「服务器管理」页保持一致。

      两个不要做的改动：
        · 不要设 HorizontalAlignment="Left" —— 卡片会按内容宽度收缩，
          内容少的那张（比如"外观"）会明显比别的窄，右边缘参差不齐。
        · 不要设 MaxWidth —— 会在窗口两侧留出大片空白，与其它页面观感割裂。
      保持默认的 Stretch，各卡片同宽且填满可用空间。
    -->
    <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="20,18" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- 数值型输入框统一宽度，避免每张卡片看起来规格不一 -->
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
      <Setter Property="Width" Value="170" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22,18,22,26">

      <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimary}" />
      <TextBlock Text="修改后立即生效并自动保存。" Margin="0,5,0,18"
                 Style="{StaticResource BodyText}" />

      <!-- ============ 采集 ============ -->
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="采集" Style="{StaticResource SectionText}" />
          <Border Style="{StaticResource Hairline}" Margin="0,12,0,16" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="刷新间隔（秒）" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource NumberBox}"
                       Text="{Binding RefreshSeconds, UpdateSourceTrigger=LostFocus}" />
              <TextBlock Style="{StaticResource FieldHint}"
                         Text="取值范围 10 - 3600 秒。间隔越短数据越实时，对目标机的压力也越大；日常统计建议 60 秒以上。" />
            </StackPanel>

            <StackPanel Grid.Column="1">
              <TextBlock Text="最大并发采集数" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource NumberBox}"
                       Text="{Binding MaxConcurrency, UpdateSourceTrigger=LostFocus}" />
              <TextBlock Style="{StaticResource FieldHint}"
                         Text="同时连接多少台服务器，1 - 64。服务器较多时适当调大可以缩短一轮采集的总耗时。" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ 告警阈值 ============ -->
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="告警阈值" Style="{StaticResource SectionText}" />
          <Border Style="{StaticResource Hairline}" Margin="0,12,0,16" />

          <!-- 阈值分档示意 -->
          <Grid Height="10" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding WarnBandWidth, Converter={StaticResource StarWidth}}" />
              <ColumnDefinition Width="{Binding CriticalBandWidth, Converter={StaticResource StarWidth}}" />
              <ColumnDefinition Width="{Binding SevereBandWidth, Converter={StaticResource StarWidth}}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource StatusGood}"
                    CornerRadius="5,0,0,5" />
            <Border Grid.Column="1" Background="{DynamicResource StatusWarning}" />
            <Border Grid.Column="2" Background="{DynamicResource StatusCritical}"
                    CornerRadius="0,5,5,0" />
          </Grid>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding WarnBandWidth, Converter={StaticResource StarWidth}}" />
              <ColumnDefinition Width="{Binding CriticalBandWidth, Converter={StaticResource StarWidth}}" />
              <ColumnDefinition Width="{Binding SevereBandWidth, Converter={StaticResource StarWidth}}" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="正常" Style="{StaticResource CaptionText}" />
            <TextBlock Grid.Column="1" Text="偏高" Style="{StaticResource CaptionText}" />
            <TextBlock Grid.Column="2" Text="告警" Style="{StaticResource CaptionText}" />
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="偏高阈值（%）" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource NumberBox}"
                       Text="{Binding WarnThreshold, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>

            <StackPanel Grid.Column="1">
              <TextBlock Text="告警阈值（%）" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource NumberBox}"
                       Text="{Binding CriticalThreshold, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
          </Grid>

          <TextBlock Style="{StaticResource FieldHint}"
                     Text="阈值只分三档：正常 / 偏高 / 告警。刻意不用四档——四档时相邻两档的颜色差异低于人眼可辨识的下限，仪表盘上反而看不出区别。" />
        </StackPanel>
      </Border>

      <!-- ============ 数据 ============ -->
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="数据与存储" Style="{StaticResource SectionText}" />
          <Border Style="{StaticResource Hairline}" Margin="0,12,0,16" />

          <TextBlock Text="原始采样保留天数" Style="{StaticResource FieldLabel}" />
          <TextBox Style="{StaticResource NumberBox}"
                   Text="{Binding RawRetentionDays, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Style="{StaticResource FieldHint}"
                     Text="按分钟级的原始采样用于绘制全天走势，超过保留期后自动清理。每日汇总数据永久保留，不受此项影响，因此长期统计不会丢失。" />

          <TextBlock Text="数据目录" Margin="0,16,0,6" Style="{StaticResource BodyText}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SunkenPanel}" Padding="11,8">
              <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource CaptionText}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding DataDirectory}" />
            </Border>
            <Button Grid.Column="1" Content="打开目录" Margin="10,0,0,0"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding OpenDataDirectoryCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ 外观 ============ -->
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="外观" Style="{StaticResource SectionText}" />
          <Border Style="{StaticResource Hairline}" Margin="0,12,0,16" />
          <CheckBox Style="{StaticResource AppCheckBox}" Content="使用深色主题"
                    IsChecked="{Binding DarkTheme, Mode=TwoWay}" />
          <TextBlock Style="{StaticResource FieldHint}"
                     Text="深色主题适合长期值守的监控大屏；浅色主题在明亮办公室里更易读。也可以按 Ctrl+D 快速切换。" />
        </StackPanel>
      </Border>

      <!-- ============ Webhook ============ -->
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Webhook 推送" Style="{StaticResource SectionText}" />
          <Border Style="{StaticResource Hairline}" Margin="0,12,0,16" />

          <CheckBox Style="{StaticResource AppCheckBox}" Content="启用 Webhook 推送"
                    IsChecked="{Binding WebhookEnabled, Mode=TwoWay}" />

          <TextBlock Style="{StaticResource FieldHint}"
                     Text="每轮采集结束后，把全部服务器的状态推送到下面的地址。" />

          <!-- 推送渠道 + 消息标题（标题仅 PushPlus 需要） -->
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="推送渠道" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource AppComboBox}"
                        SelectedIndex="{Binding WebhookProviderIndex, Mode=TwoWay}">
                <ComboBoxItem Content="通用 JSON（自建接口）" />
                <ComboBoxItem Content="PushPlus（微信推送）" />
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                        Visibility="{Binding IsPushPlus, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="消息标题" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource AppTextBox}"
                       Text="{Binding WebhookTitle, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="接口地址" Margin="0,14,0,6" Style="{StaticResource BodyText}" />
          <TextBox Style="{StaticResource AppTextBox}"
                   Text="{Binding WebhookUrl, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Style="{StaticResource FieldHint}" Text="{Binding WebhookUrlHint}" />

          <TextBlock Text="{Binding WebhookTokenLabel}" Margin="0,14,0,6"
                     Style="{StaticResource BodyText}" />
          <TextBox Style="{StaticResource AppTextBox}"
                   Text="{Binding WebhookToken, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Style="{StaticResource FieldHint}" Text="{Binding WebhookTokenHint}" />

          <!-- PushPlus 专有：消息模板 + 群组编码 -->
          <Grid Margin="0,14,0,0"
                Visibility="{Binding IsPushPlus, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="消息模板" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource AppComboBox}"
                        SelectedIndex="{Binding WebhookTemplateIndex, Mode=TwoWay}">
                <ComboBoxItem Content="纯文本 txt" />
                <ComboBoxItem Content="html" />
                <ComboBoxItem Content="markdown" />
                <ComboBoxItem Content="json" />
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="群组编码（可留空）" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource AppTextBox}"
                       Text="{Binding WebhookTopic, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource FieldHint}"
                     Text="群组编码留空表示只推给自己；填了则推给该群组的全部成员。"
                     Visibility="{Binding IsPushPlus, Converter={StaticResource BoolToVis}}" />

          <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,16,0,0"
                    Content="仅在存在异常时推送"
                    IsChecked="{Binding WebhookOnlyOnProblem, Mode=TwoWay}" />
          <TextBlock Style="{StaticResource FieldHint}"
                     Text="勾选后，只有出现离线、偏高或告警时才推送，避免无人值守时把接口刷爆。" />

          <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,12,0,0"
                    Content="忽略 HTTPS 证书错误"
                    IsChecked="{Binding WebhookIgnoreCertErrors, Mode=TwoWay}" />
          <TextBlock Style="{StaticResource FieldHint}"
                     Text="内网接口常用自签名证书，勾选后才能推送到 https 地址。默认关闭。" />

          <Border Style="{StaticResource Hairline}" Margin="0,16,0,14" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="最近推送状态" Style="{StaticResource CaptionText}" />
              <TextBlock Text="{Binding WebhookStatus}" Margin="0,3,0,0"
                         TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
            <Button Grid.Column="1" Content="测试推送" VerticalAlignment="Center"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding TestWebhookCommand}" />
          </Grid>

          <TextBlock Style="{StaticResource FieldHint}"
                     Text="通用 JSON：推送内容含 summary（总数/在线/异常数/平均用量）与 servers 数组（每台的 CPU、内存、磁盘、各分区明细、更新时间、失败原因）。"
                     Visibility="{Binding IsPushPlus, Converter={StaticResource InverseBoolToVis}}" />
          <TextBlock Style="{StaticResource FieldHint}"
                     Text="PushPlus：推送一段可直接阅读的告警摘要（异常项在前），不是原始 JSON。"
                     Visibility="{Binding IsPushPlus, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Border>

      <!-- ============ 诊断日志 ============ -->
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="诊断日志" Style="{StaticResource SectionText}" />
          <Border Style="{StaticResource Hairline}" Margin="0,12,0,16" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="日志级别" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource AppComboBox}"
                        SelectedIndex="{Binding LogLevelIndex, Mode=TwoWay}">
                <ComboBoxItem Content="error — 仅严重错误" />
                <ComboBoxItem Content="warn — 错误 + 警告" />
                <ComboBoxItem Content="info — 一般操作信息（默认）" />
                <ComboBoxItem Content="debug — 详细信息" />
                <ComboBoxItem Content="trace — 全部日志，最详细" />
              </ComboBox>
              <TextBlock Style="{StaticResource FieldHint}"
                         Text="{Binding LogLevelDescription}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="日志保留天数" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource NumberBox}"
                       Text="{Binding LogRetentionDays, UpdateSourceTrigger=LostFocus}" />
              <TextBlock Style="{StaticResource FieldHint}"
                         Text="按天分文件存放，超期自动清理。排查完问题后建议把级别调回 info，否则日志会增长得很快。" />
            </StackPanel>
          </Grid>

          <TextBlock Text="日志目录" Margin="0,16,0,6" Style="{StaticResource BodyText}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SunkenPanel}" Padding="11,8">
              <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource CaptionText}"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding LogDirectory}" />
            </Border>
            <Button Grid.Column="1" Content="打开目录" Margin="10,0,0,0"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding OpenLogDirectoryCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ AI 助手 ============ -->
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="AI 助手" Style="{StaticResource SectionText}" />
          <Border Style="{StaticResource Hairline}" Margin="0,12,0,16" />

          <CheckBox Style="{StaticResource AppCheckBox}" Content="启用 AI 功能"
                    IsChecked="{Binding AiEnabled, Mode=TwoWay}" />
          <TextBlock Style="{StaticResource FieldHint}"
                     Text="关闭后界面上的 AI 相关按钮会隐藏，此处的配置保留。" />

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource AppTextBox}"
                       Text="{Binding AiEndpoint, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 可编辑下拉框：列表来自接口实际返回，也可以手填自定义名字 -->
                <ComboBox Grid.Column="0" Style="{StaticResource AppComboBox}"
                          IsEditable="True"
                          ItemsSource="{Binding AiModels}"
                          Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="获取" Margin="8,0,0,0"
                        Style="{StaticResource GhostButton}" Padding="13,7"
                        ToolTip="从接口拉取当前可用的模型名（调用 GET /models）"
                        Command="{Binding FetchAiModelsCommand}" />
              </Grid>
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource FieldHint}"
                     Text="走 OpenAI 兼容协议，DeepSeek 官方与内网自建的 vLLM / Ollama 都支持。点「获取」可直接拉取对方当前支持的模型名；也可以手填——服务商改名比程序发版频繁得多。" />

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="API 密钥" Style="{StaticResource FieldLabel}" />
              <PasswordBox x:Name="AiKeyBox" Style="{StaticResource AppPasswordBox}"
                           PasswordChanged="OnAiKeyChanged"
                           LostFocus="OnAiKeyLostFocus" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="超时（秒）" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource NumberBox}"
                       Text="{Binding AiTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource FieldHint}"
                     Text="密钥与服务器口令一样用 Windows DPAPI 加密后保存，不落明文。" />

          <Border Style="{StaticResource Hairline}" Margin="0,16,0,14" />

          <CheckBox Style="{StaticResource AppCheckBox}"
                    Content="用 AI 生成告警正文"
                    IsEnabled="{Binding AiEnabled}"
                    IsChecked="{Binding AiSummaryEnabled, Mode=TwoWay}" />
          <TextBlock Style="{StaticResource FieldHint}"
                     Text="开启后，Webhook 推送的正文改由 AI 根据本次采集数据写成一段人话，替代模板拼装的正文；通用 JSON 渠道会额外多一个 aiSummary 字段，原有结构化字段不变。生成失败会自动退回模板正文，不会漏推。发不推送仍由阈值和上面的「仅异常时推送」决定，AI 不参与这个判断。" />

          <TextBlock Style="{StaticResource FieldHint}"
                     Foreground="{DynamicResource StatusWarning}"
                     Text="注意：开启后会把服务器名称、IP、系统类型和用量数据发送到上面填写的接口地址。若填的是公网服务，这些内网信息会离开内网；有合规要求时请改指向内网自建的兼容接口。" />

          <Border Style="{StaticResource Hairline}" Margin="0,16,0,14" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="最近测试结果" Style="{StaticResource CaptionText}" />
              <TextBlock Text="{Binding AiStatus}" Margin="0,3,0,0"
                         TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
            <Button Grid.Column="1" Content="测试连接" VerticalAlignment="Center"
                    Style="{StaticResource GhostButton}"
                    ToolTip="发一条极短的请求，同时验证地址、密钥、模型名三项"
                    Command="{Binding TestAiCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ 兼容性说明 ============ -->
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="运行环境与排错" Style="{StaticResource SectionText}" />
          <Border Style="{StaticResource Hairline}" Margin="0,12,0,16" />

          <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="21"
                     Text="本程序基于 .NET Framework 4.5 与 WPF 编写，可直接运行于 Windows Server 2012 R2 及更高版本，无需安装任何运行时。"/>

          <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                     LineHeight="21"
                     Text="· Linux 目标机：需要开启 sshd 并允许口令登录（SSH 端口默认 22）。"/>
          <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                     LineHeight="21"
                     Text="· Windows 目标机（WMI）：账号需在目标机管理员组内，且防火墙放行 WMI（135 端口及动态端口）。"/>
          <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                     LineHeight="21"
                     Text="· Windows 目标机（WinRM）：目标需执行过 Enable-PSRemoting；工作组环境下还需在本机管理员命令行执行 winrm set winrm/config/client @{TrustedHosts=&quot;目标IP&quot;}。"/>

          <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                     Text="口令使用 Windows DPAPI（当前用户范围）加密保存，配置文件被拷到其它机器或其它账户下将无法解密，需要重新填写。" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
