<UserControl x:Class="ServerMonitor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServerMonitor.Controls"
             FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
             TextOptions.TextFormattingMode="Display">

  <UserControl.Resources>

    <!-- ============ 磁盘行 ============
         每个分区最多三行：
           第一行  盘符（主文字）+ 已用/总容量（静音）—— 容量原来是悬浮提示，信息藏得太深
           第二行  用量条 + 百分比（右对齐，等宽数字，多行纵向对齐）
           第三行  容量趋势标注（"按当前增速约 25 天后写满"）；没有预测时整行收起，行高不变
         盘符用主文字色而非静音色：在 Windows 上 C:/D: 才是识别分区的主要依据。 -->
    <DataTemplate x:Key="DiskRowTemplate">
      <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Mount}" FontSize="11.5"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     ToolTip="{Binding Mount}"
                     Foreground="{DynamicResource TextPrimary}" />
          <TextBlock Grid.Column="1" Text="{Binding UsageText}" Margin="8,0,0,0"
                     FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMuted}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:MeterBar Grid.Column="0" Height="5" VerticalAlignment="Center"
                             Value="{Binding Percent}" Level="{Binding Level}"
                             ToolTip="{Binding FreeText}" />
          <TextBlock Grid.Column="1" MinWidth="36" TextAlignment="Right" Margin="8,0,0,0"
                     Text="{Binding Percent, Converter={StaticResource PercentText},
                            ConverterParameter=short}"
                     Style="{StaticResource NumericText}" FontSize="11.5" />
        </Grid>

        <!-- 第三行：容量趋势。ForecastText 为空时 StringToVis 返回 Collapsed，
             整行消失、行高不变——没有预测的分区看起来和从前一模一样。 -->
        <TextBlock Grid.Row="2" Margin="0,4,0,0"
                   Text="{Binding ForecastText}"
                   FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextMuted}"
                   Visibility="{Binding ForecastText,
                               Converter={StaticResource StringToVis}}" />
      </Grid>
    </DataTemplate>

    <!-- ============ 服务器卡片 ============ -->
    <DataTemplate x:Key="ServerCardTemplate">
      <!-- Tag 上挂着页面的 MainViewModel：ContextMenu 在独立的可视树上，
           拿不到 UserControl 的 DataContext，只能靠 PlacementTarget 中转。
           卡片自身是 ContextMenu 的 DataContext（用于 CommandParameter），
           命令则从 Tag 上取。 -->
      <Border Width="340" Margin="0,0,14,14" Style="{StaticResource Card}"
              Tag="{Binding DataContext,
                    RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="编辑…"
                      Command="{Binding PlacementTarget.Tag.EditServerCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="测试连接"
                      Command="{Binding PlacementTarget.Tag.TestConnectionCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="停用 / 启用"
                      Command="{Binding PlacementTarget.Tag.ToggleEnabledCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="删除"
                      Command="{Binding PlacementTarget.Tag.DeleteServerCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
          </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Margin="16,14,16,15">

          <!-- 标题行 -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{Binding OverallLevel, Converter={StaticResource HealthBrush}}" />
              <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="13.5"
                         FontWeight="SemiBold" MaxWidth="176"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <!-- 整体状态：图标 + 文字，不靠颜色单独表意 -->
              <Path Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                    StrokeThickness="2" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    VerticalAlignment="Center" Margin="0,0,4,0"
                    Data="{Binding OverallLevel, Converter={StaticResource HealthIcon}}"
                    Stroke="{Binding OverallLevel, Converter={StaticResource HealthBrush}}" />
              <TextBlock Text="{Binding OverallLevelText}" FontSize="11" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />

              <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="4"
                      Padding="7,2" VerticalAlignment="Center">
                <TextBlock Text="{Binding OsLabel}" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondary}" />
              </Border>
            </StackPanel>
          </Grid>

          <TextBlock Margin="15,5,0,0" Style="{StaticResource CaptionText}"
                     TextTrimming="CharacterEllipsis">
            <Run Text="{Binding AddressText, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding ProtocolLabel, Mode=OneWay}" />
          </TextBlock>

          <!-- 离线原因 -->
          <Border Margin="0,11,0,0" Padding="10,8" CornerRadius="6"
                  Background="{DynamicResource SurfaceSunken}"
                  Visibility="{Binding IsOnline, Converter={StaticResource InverseBoolToVis}}">
            <!-- Grid 而非横向 StackPanel：后者无限宽度测量会让 Wrap 失效 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" Fill="Transparent"
                    StrokeThickness="1.8" StrokeLineJoin="Round"
                    Data="{StaticResource IconWarning}"
                    Stroke="{DynamicResource StatusOffline}" VerticalAlignment="Top" />
              <!-- 卡片空间有限：最多三行，完整原因放进悬浮提示 -->
              <TextBlock Grid.Column="1" Text="{Binding ErrorText}" Margin="8,0,0,0"
                         TextWrapping="Wrap" FontSize="11.5" LineHeight="16" MaxHeight="49"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding ErrorText}"
                         Foreground="{DynamicResource TextSecondary}" />
            </Grid>
          </Border>

          <Border Style="{StaticResource Hairline}" Margin="0,12,0,0" />

          <!-- 三项核心指标 -->
          <UniformGrid Rows="1" Columns="3" Margin="0,14,0,0">

            <StackPanel>
              <controls:RingGauge Width="74" Height="74" HorizontalAlignment="Center"
                                  Value="{Binding CpuPercent}" Level="{Binding CpuLevel}"
                                  Thickness="7" ValueFontSize="20" UnitFontSize="10.5" />
              <TextBlock Text="CPU" HorizontalAlignment="Center" Margin="0,7,0,0"
                         Style="{StaticResource CaptionText}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <Ellipse Width="5.5" Height="5.5" VerticalAlignment="Center"
                         Fill="{Binding CpuLevel, Converter={StaticResource HealthBrush}}" />
                <TextBlock Text="{Binding CpuLevelText}" FontSize="11" Margin="5,0,0,0"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
            </StackPanel>

            <StackPanel>
              <controls:RingGauge Width="74" Height="74" HorizontalAlignment="Center"
                                  Value="{Binding MemPercent}" Level="{Binding MemLevel}"
                                  Thickness="7" ValueFontSize="20" UnitFontSize="10.5" />
              <TextBlock Text="内存" HorizontalAlignment="Center" Margin="0,7,0,0"
                         Style="{StaticResource CaptionText}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <Ellipse Width="5.5" Height="5.5" VerticalAlignment="Center"
                         Fill="{Binding MemLevel, Converter={StaticResource HealthBrush}}" />
                <TextBlock Text="{Binding MemLevelText}" FontSize="11" Margin="5,0,0,0"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
            </StackPanel>

            <StackPanel>
              <controls:RingGauge Width="74" Height="74" HorizontalAlignment="Center"
                                  Value="{Binding DiskPercent}" Level="{Binding DiskLevel}"
                                  Thickness="7" ValueFontSize="20" UnitFontSize="10.5" />
              <TextBlock Text="磁盘" HorizontalAlignment="Center" Margin="0,7,0,0"
                         Style="{StaticResource CaptionText}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <Ellipse Width="5.5" Height="5.5" VerticalAlignment="Center"
                         Fill="{Binding DiskLevel, Converter={StaticResource HealthBrush}}" />
                <TextBlock Text="{Binding DiskLevelText}" FontSize="11" Margin="5,0,0,0"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
            </StackPanel>
          </UniformGrid>

          <!-- 容量补充说明 -->
          <Grid Margin="0,11,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="内存用量" Style="{StaticResource CaptionText}" />
              <TextBlock Text="{Binding MemText}" Style="{StaticResource NumericText}"
                         FontSize="11.5" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="磁盘容量" Style="{StaticResource CaptionText}" />
              <TextBlock Text="{Binding DiskText}" Style="{StaticResource NumericText}"
                         FontSize="11.5" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

          <!-- CPU 走势 -->
          <Border Style="{StaticResource Hairline}" Margin="0,12,0,0" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:Sparkline Grid.Column="0" Height="38"
                                Values="{Binding CpuHistory}" SeriesKey="Series1" />
            <TextBlock Grid.Column="1" Text="CPU 走势" Margin="10,0,0,0"
                       VerticalAlignment="Bottom" Style="{StaticResource CaptionText}" />
          </Grid>

          <!-- 磁盘明细 -->
          <Border Style="{StaticResource Hairline}" Margin="0,12,0,0" />
          <ItemsControl ItemsSource="{Binding TopDisks}" Margin="0,10,0,0"
                        ItemTemplate="{StaticResource DiskRowTemplate}" />
          <TextBlock Text="{Binding MoreDisksText}" Margin="0,1,0,0"
                     Style="{StaticResource CaptionText}"
                     ToolTip="{Binding MoreDisksTooltip}"
                     Visibility="{Binding HasMoreDisks, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- ============ 概览小卡 ============ -->
    <!-- 概览卡片等分排布：7 项始终在同一行，窗口变窄时整体收缩，
         不会出现最后一项被挤到第二行的落单情况 -->
    <Style x:Key="KpiTile" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="22,18,22,26">

        <!-- ================= 概览指标 ================= -->
        <UniformGrid Rows="1" Columns="7" Margin="0,0,-10,16">
          <Border Style="{StaticResource KpiTile}">
            <StackPanel>
              <TextBlock Text="服务器总数" Style="{StaticResource CaptionText}" />
              <TextBlock Text="{Binding TotalCount}" Style="{StaticResource KpiValueText}"
                         Margin="0,3,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource KpiTile}">
            <StackPanel>
              <TextBlock Text="在线" Style="{StaticResource CaptionText}" />
              <TextBlock Text="{Binding OnlineCount}" Style="{StaticResource KpiValueText}"
                         Margin="0,3,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource KpiTile}">
            <StackPanel>
              <TextBlock Text="偏高" Style="{StaticResource CaptionText}" />
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,4,7,0"
                         Fill="{DynamicResource StatusWarning}" />
                <TextBlock Text="{Binding WarningCount}" Style="{StaticResource KpiValueText}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource KpiTile}">
            <StackPanel>
              <TextBlock Text="告警" Style="{StaticResource CaptionText}" />
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,4,7,0"
                         Fill="{DynamicResource StatusCritical}" />
                <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource KpiValueText}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource KpiTile}">
            <StackPanel>
              <TextBlock Text="平均 CPU" Style="{StaticResource CaptionText}" />
              <TextBlock Text="{Binding AvgCpuText}" Style="{StaticResource KpiValueText}"
                         Margin="0,3,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource KpiTile}">
            <StackPanel>
              <TextBlock Text="平均内存" Style="{StaticResource CaptionText}" />
              <TextBlock Text="{Binding AvgMemText}" Style="{StaticResource KpiValueText}"
                         Margin="0,3,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource KpiTile}">
            <StackPanel>
              <TextBlock Text="平均磁盘" Style="{StaticResource CaptionText}" />
              <TextBlock Text="{Binding AvgDiskText}" Style="{StaticResource KpiValueText}"
                         Margin="0,3,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- ================= 工具条 ================= -->
        <Grid Margin="0,6,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource SunkenPanel}" Width="248" Height="34">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Column="0" Width="14" Height="14"
                       Margin="11,0,0,0" VerticalAlignment="Center">
                <Path Style="{StaticResource IconPath}"
                      Data="{StaticResource IconSearch}"
                      Stroke="{DynamicResource TextMuted}" />
              </Viewbox>
              <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                       VerticalContentAlignment="Center" Padding="8,0,10,0" FontSize="12.5"
                       Foreground="{DynamicResource TextPrimary}"
                       CaretBrush="{DynamicResource Accent}"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
              <!-- 占位提示：WPF 的 TextBox 没有原生 placeholder，用一层不可命中的文字模拟 -->
              <TextBlock Grid.Column="1" Text="搜索名称、地址或分组…"
                         Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                         Style="{StaticResource CaptionText}"
                         Visibility="{Binding SearchText,
                                      Converter={StaticResource StringToVis},
                                      ConverterParameter=inverse}" />
            </Grid>
          </Border>

          <CheckBox Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                    Style="{StaticResource AppCheckBox}" Content="只看异常"
                    IsChecked="{Binding ShowOnlyProblems}" />

          <StackPanel Grid.Column="3" Orientation="Horizontal">
            <TextBlock Text="{Binding FleetLevelText}" VerticalAlignment="Center"
                       Margin="0,0,14,0" Style="{StaticResource CaptionText}" />
            <Button Content="立即刷新" Style="{StaticResource GhostButton}"
                    ToolTip="立刻开始一轮采集（快捷键 F5）"
                    Command="{Binding RefreshNowCommand}" />
            <Button Content="生成巡检报告" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                    ToolTip="把当前所有服务器的状态导出为一份 txt 报告"
                    Command="{Binding ExportReportCommand}" />
            <Button Content="添加服务器" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                    Command="{Binding AddServerCommand}" />
          </StackPanel>
        </Grid>

        <!-- ================= 服务器卡片 ================= -->
        <ItemsControl ItemsSource="{Binding ServersView}"
                      ItemTemplate="{StaticResource ServerCardTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- 空状态 -->
        <Border Style="{StaticResource Card}" Padding="40,44" Margin="0,6,0,0"
                Visibility="{Binding Servers.Count, Converter={StaticResource EmptyToVis}}">
          <StackPanel HorizontalAlignment="Center">
            <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Center"
                    Background="{DynamicResource AccentSoft}">
              <Path Data="{StaticResource IconServer}" Width="26" Height="26"
                    Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Fill="Transparent" Stretch="Uniform" />
            </Border>
            <TextBlock Text="还没有配置服务器" Margin="0,16,0,0" FontSize="14"
                       FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                       Style="{StaticResource BodyText}"
                       Text="添加服务器的内网 IP、账号口令并选择系统类型，即可开始实时监控 CPU、内存与磁盘用量。" />
            <Button Content="添加第一台服务器" Style="{StaticResource PrimaryButton}"
                    Margin="0,18,0,0" HorizontalAlignment="Center"
                    Command="{Binding AddServerCommand}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
