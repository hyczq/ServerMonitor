<UserControl x:Class="ServerMonitor.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
             TextOptions.TextFormattingMode="Display">

  <UserControl.Resources>

    <!--
      日志行。用等宽字体（Consolas）而不是界面正文字体：
      时间戳和级别需要纵向对齐才好扫读，比例字体做不到。
      Consolas 从 Vista 起就在系统里，2012 R2 上没问题。
    -->
    <DataTemplate x:Key="LogRowTemplate">
      <Grid Margin="0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="116" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                   FontFamily="Consolas, Courier New" FontSize="11.5"
                   Foreground="{DynamicResource TextMuted}" />

        <!-- 级别文字本身就是标签，颜色只是辅助扫读 -->
        <TextBlock Grid.Column="1" Text="{Binding LevelText}"
                   FontFamily="Consolas, Courier New" FontSize="11.5"
                   FontWeight="SemiBold"
                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />

        <TextBlock Grid.Column="2" Text="{Binding ScopeText}"
                   FontFamily="Consolas, Courier New" FontSize="11.5"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondary}" />

        <TextBlock Grid.Column="3" Text="{Binding Message}"
                   FontFamily="Consolas, Microsoft YaHei UI, Microsoft YaHei"
                   FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}" />
      </Grid>
    </DataTemplate>

    <Style x:Key="LogRow" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                    Padding="8,2" Margin="0,0,0,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </UserControl.Resources>

  <Grid Margin="22,18,22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题与工具条 -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel>
        <TextBlock Text="诊断日志" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="{Binding Summary}" Margin="0,5,0,0"
                   Style="{StaticResource BodyText}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="显示级别" VerticalAlignment="Center" Margin="0,0,9,0"
                   Style="{StaticResource CaptionText}" />
        <ComboBox Width="176" Style="{StaticResource AppComboBox}"
                  SelectedIndex="{Binding LevelFilterIndex, Mode=TwoWay}">
          <ComboBoxItem Content="error — 仅严重错误" />
          <ComboBoxItem Content="warn — 错误 + 警告" />
          <ComboBoxItem Content="info — 一般操作信息" />
          <ComboBoxItem Content="debug — 详细信息" />
          <ComboBoxItem Content="trace — 全部日志" />
        </ComboBox>

        <CheckBox Style="{StaticResource AppCheckBox}" Content="自动滚动"
                  Margin="14,0,0,0" VerticalAlignment="Center"
                  IsChecked="{Binding AutoScroll, Mode=TwoWay}" />

        <Button Content="导出" Style="{StaticResource GhostButton}" Margin="14,0,0,0"
                ToolTip="把当前显示的日志导出为文件，便于发给他人排查"
                Command="{Binding ExportCommand}" />
        <Button Content="打开目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                ToolTip="日志按天保存在数据目录的 logs 子目录下"
                Command="{Binding OpenFolderCommand}" />
        <Button Content="清空显示" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                ToolTip="只清空界面显示，磁盘上的日志文件不受影响"
                Command="{Binding ClearCommand}" />
      </StackPanel>
    </Grid>

    <!-- 日志列表 -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6,8">
      <Grid>
        <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource LogRow}"
                 ItemTemplate="{StaticResource LogRowTemplate}"
                 ItemsSource="{Binding Entries}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding Entries.Count, Converter={StaticResource EmptyToVis}}">
          <TextBlock Text="当前级别下没有日志" HorizontalAlignment="Center"
                     Style="{StaticResource BodyText}" />
          <TextBlock Text="把上方「显示级别」调低（比如选 trace）可以看到更多内容"
                     Margin="0,8,0,0" HorizontalAlignment="Center"
                     Style="{StaticResource CaptionText}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
