<UserControl x:Class="ServerMonitor.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
             TextOptions.TextFormattingMode="Display">

  <UserControl.Resources>

    <!-- 表头与数据行必须使用完全相同的列定义，纵向才能对齐 -->
    <DataTemplate x:Key="ServerRowTemplate">
      <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="12,9"
              BorderBrush="Transparent" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="1.5*" MinWidth="120" />
            <ColumnDefinition Width="74" />
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="86" />
            <ColumnDefinition Width="186" />
          </Grid.ColumnDefinitions>

          <!-- 状态 -->
          <Ellipse Grid.Column="0" Width="8" Height="8" HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Fill="{Binding OverallLevel, Converter={StaticResource HealthBrush}}" />

          <!-- 名称 / 地址 / 分组 -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextPrimary}" />
              <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="3"
                      Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding Config.Group, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding Config.Group}" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding AddressText}" Style="{StaticResource CaptionText}"
                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            <!-- 离线原因放在名称列：这一列最宽，能完整显示原因，
                 挤在窄列里会被截断成没有信息量的半句话 -->
            <TextBlock Text="{Binding ErrorText}" Margin="0,3,0,0" FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ErrorText}"
                       Visibility="{Binding ErrorText, Converter={StaticResource StringToVis}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource StatusCritical}" />
                  <Style.Triggers>
                    <!-- 主动停用不是故障，别用报错的红色 -->
                    <DataTrigger Binding="{Binding Config.Enabled}" Value="False">
                      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <!-- 系统 -->
          <TextBlock Grid.Column="2" Text="{Binding OsLabel}" VerticalAlignment="Center"
                     Style="{StaticResource BodyText}" />

          <!-- 通道 -->
          <TextBlock Grid.Column="3" Text="{Binding ProtocolLabel}" VerticalAlignment="Center"
                     Style="{StaticResource BodyText}" />

          <!-- 三项指标 -->
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                     Fill="{Binding CpuLevel, Converter={StaticResource HealthBrush}}" />
            <TextBlock Text="{Binding CpuPercent, Converter={StaticResource PercentText},
                                      ConverterParameter=short}"
                       Style="{StaticResource NumericText}" />
          </StackPanel>

          <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                     Fill="{Binding MemLevel, Converter={StaticResource HealthBrush}}" />
            <TextBlock Text="{Binding MemPercent, Converter={StaticResource PercentText},
                                      ConverterParameter=short}"
                       Style="{StaticResource NumericText}" />
          </StackPanel>

          <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                     Fill="{Binding DiskLevel, Converter={StaticResource HealthBrush}}" />
            <TextBlock Text="{Binding DiskPercent, Converter={StaticResource PercentText},
                                      ConverterParameter=short}"
                       Style="{StaticResource NumericText}" />
          </StackPanel>

          <!-- 更新时间 -->
          <TextBlock Grid.Column="7" Text="{Binding LastUpdatedText}"
                     Style="{StaticResource CaptionText}" VerticalAlignment="Center" />

          <!-- 操作：Padding 保持紧凑，四个按钮要能完整放进 196px 的列宽 -->
          <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center"
                      HorizontalAlignment="Right">
            <Button Content="测试" Style="{StaticResource GhostButton}" Padding="9,4"
                    FontSize="11.5" ToolTip="测试连接"
                    Command="{Binding DataContext.TestConnectionCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" />
            <Button Content="编辑" Style="{StaticResource GhostButton}" Padding="9,4"
                    FontSize="11.5" Margin="5,0,0,0" ToolTip="编辑配置"
                    Command="{Binding DataContext.EditServerCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" />
            <Button Content="{Binding Config.Enabled, Converter={StaticResource EnabledLabel}}"
                    Style="{StaticResource GhostButton}" Padding="9,4" FontSize="11.5"
                    Margin="5,0,0,0" ToolTip="暂停或恢复对该服务器的采集"
                    Command="{Binding DataContext.ToggleEnabledCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" />
            <Button Content="删除" Style="{StaticResource GhostButton}" Padding="9,4"
                    FontSize="11.5" Margin="5,0,0,0" ToolTip="删除该服务器及其历史统计"
                    Command="{Binding DataContext.DeleteServerCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Config.Enabled}" Value="False">
          <Setter TargetName="Row" Property="Opacity" Value="0.5" />
        </DataTrigger>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </UserControl.Resources>

  <Grid Margin="22,18,22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="服务器管理" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Margin="0,5,0,0" Style="{StaticResource BodyText}"
                   Text="配置内网地址、账号口令与系统类型。口令使用 Windows DPAPI 加密后保存在本机，不会明文落盘。" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="立即刷新" Style="{StaticResource GhostButton}"
                Command="{Binding RefreshNowCommand}" />
        <Button Content="添加服务器" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                Command="{Binding AddServerCommand}" />
      </StackPanel>
    </Grid>

    <!-- 表头 -->
    <Border Grid.Row="1" Style="{StaticResource SunkenPanel}" Padding="13,9" Margin="0,0,0,4"
            CornerRadius="8,8,0,0" BorderThickness="1,1,1,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="1.5*" MinWidth="120" />
          <ColumnDefinition Width="74" />
          <ColumnDefinition Width="62" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="86" />
          <ColumnDefinition Width="186" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="状态" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="1" Text="名称 / 地址" Margin="4,0,0,0"
                   Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="2" Text="系统" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="3" Text="通道" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="4" Text="CPU" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="5" Text="内存" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="6" Text="磁盘" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="7" Text="更新时间" Style="{StaticResource TableHeaderText}" />
        <TextBlock Grid.Column="8" Text="操作" HorizontalAlignment="Right"
                   Style="{StaticResource TableHeaderText}" />
      </Grid>
    </Border>

    <!-- 数据行 -->
    <Border Grid.Row="2" Style="{StaticResource Card}" CornerRadius="0,0,10,10"
            BorderThickness="1,0,1,1" Padding="0,3">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,3">
          <ItemsControl ItemsSource="{Binding ServersView, Mode=OneWay}"
                        ItemTemplate="{StaticResource ServerRowTemplate}" />
        </ScrollViewer>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50"
                    Visibility="{Binding Servers.Count, Converter={StaticResource EmptyToVis}}">
          <TextBlock Text="还没有配置服务器" HorizontalAlignment="Center"
                     Style="{StaticResource BodyText}" />
          <Button Content="添加服务器" Style="{StaticResource PrimaryButton}"
                  Margin="0,14,0,0" HorizontalAlignment="Center"
                  Command="{Binding AddServerCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
