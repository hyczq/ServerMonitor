<Window x:Class="ServerMonitor.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="提示"
        SizeToContent="Height"
        Width="440"
        MinHeight="170"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="{DynamicResource SurfaceCard}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        TextOptions.TextFormattingMode="Display">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1">
    <Grid Margin="22,20,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 标题行 -->
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <Border x:Name="AccentBar" Width="3" Height="16" CornerRadius="1.5"
                Background="{DynamicResource Accent}" VerticalAlignment="Center" />
        <TextBlock x:Name="TitleText" Text="提示" Margin="10,0,0,0"
                   Style="{StaticResource TitleText}" VerticalAlignment="Center" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" MaxHeight="380" VerticalScrollBarVisibility="Auto"
                    Margin="0,16,0,0">
        <TextBlock x:Name="BodyText" Text="" TextWrapping="Wrap"
                   Style="{StaticResource BodyText}" LineHeight="20" />
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="0,20,0,0">
        <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}"
                MinWidth="82" Margin="0,0,10,0" Click="OnCancel" Visibility="Collapsed" />
        <Button x:Name="OkButton" Content="知道了" Style="{StaticResource PrimaryButton}"
                MinWidth="82" Click="OnOk" IsDefault="True" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
